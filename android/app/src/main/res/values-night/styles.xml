<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the app starts, before Android 12: the mark on
         the launch colour. Removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window once the process has started, and behind the Flutter
         UI. The same colour as the launch screen, so nothing flashes
         between the two. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
