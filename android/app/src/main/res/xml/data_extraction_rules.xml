<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Only the folder holding the database is backed
     up or transferred; with an include present, everything else is left
     out, including the notification schedules kept in shared preferences. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter"/>
    </device-transfer>
</data-extraction-rules>
